{
  "name": "relaid",
  "private": true,
  "scripts": {
    "build:apk": "cd apps/mobile && pnpm run build:apk",
    "dev": "turbo run dev --filter=!local",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:start:dev": "pm2 start ecosystem.config.js --env development",
    "pm2:stop": "pm2 delete ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 ls"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "pm2": "^6.0.14",
    "turbo": "^2.9.3",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
