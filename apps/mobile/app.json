{
  "expo": {
    "name": "relaid",
    "slug": "relaid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/relaid.png",
    "scheme": "relaid",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vishal2457.relaid"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/images/relaid.png",
        "backgroundImage": "./src/assets/images/android-icon-background.png",
        "monochromeImage": "./src/assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "package": "com.vishal2457.relaid"
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/relaid.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/relaid.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Relaid to scan pairing QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Relaid to choose a QR code image from your library."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/assets/images/relaid.png",
          "color": "#2563EB",
          "defaultChannel": "default",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b386c0d1-0ac9-4b1f-b9eb-f6068a04bc1f"
      }
    }
  }
}
