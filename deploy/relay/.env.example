RELAY_IMAGE=ghcr.io/OWNER/relaid-relay:latest
RELAY_PORT=3001
PORT=3001
HOST=0.0.0.0
PUBLIC_BASE_URL=https://relay.example.com
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_REDIRECT_URI=https://relay.example.com/api/github/auth/callback
APP_DEEP_LINK_SCHEME=relaid
ENCRYPTION_KEY=replace_with_64_char_hex_key
CORS_ORIGIN=*
LOG_LEVEL=info
DB_PATH=/data/chat-server.db
LOGS_DIR=/logs
PAIRING_SESSION_TTL_MS=300000
SOCKET_REQUEST_TIMEOUT_MS=30000
